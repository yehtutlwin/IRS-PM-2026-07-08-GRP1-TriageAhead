{"t": "19:34:21", "kind": "question", "slot": "dyn:complaint.onset+patient.age", "text": "I understand he can't stand. About how long ago did the fall happen, and could you tell me his age?", "fields": ["complaint.onset", "patient.age"], "offered": ["complaint.onset", "E.mechanism", "patient.age", "patient.sex", "complaint.fever", "infection.rash"]}
