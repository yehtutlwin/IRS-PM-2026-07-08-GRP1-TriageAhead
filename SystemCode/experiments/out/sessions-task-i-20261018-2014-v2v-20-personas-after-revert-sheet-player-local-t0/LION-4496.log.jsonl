{"t": "19:34:28", "kind": "question", "slot": "dyn:E.mechanism+patient.sex", "text": "I've noted the fall. To help the team, could you tell me if the patient is male or female?", "fields": ["E.mechanism", "patient.sex"], "offered": ["E.mechanism", "patient.sex", "complaint.fever", "infection.rash", "infection.travel_14d", "infection.contacts"]}
