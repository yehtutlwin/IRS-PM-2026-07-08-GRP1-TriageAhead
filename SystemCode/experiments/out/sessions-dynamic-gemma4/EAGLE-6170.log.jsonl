{"t": "03:39:22", "kind": "question", "slot": "dyn:red_flags.responsive+red_flags.chest_pain_now+red_flags.breathing_difficulty+red_flags.heavy_bleeding", "text": "I'm here to help get you prepared for the hospital. Is the patient awake and responding normally, and are they currently experiencing any chest pain, trouble breathing, or heavy bleeding?", "fields": ["red_flags.responsive", "red_flags.chest_pain_now", "red_flags.breathing_difficulty", "red_flags.heavy_bleeding"], "offered": ["red_flags.responsive", "red_flags.chest_pain_now", "red_flags.breathing_difficulty", "red_flags.heavy_bleeding", "complaint.category", "complaint.text"]}
