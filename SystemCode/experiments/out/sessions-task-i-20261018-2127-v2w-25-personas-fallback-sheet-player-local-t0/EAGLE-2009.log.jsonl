{"t": "20:36:50", "kind": "question", "slot": "dyn:complaint.fever", "text": "I'm sorry to hear about your father's fall. Does he have a fever or any new rashes?", "fields": ["complaint.fever"], "offered": ["complaint.fever", "infection.rash", "infection.travel_14d", "infection.contacts", "ams.changed_from_baseline", "complaint.pain_rating"]}
