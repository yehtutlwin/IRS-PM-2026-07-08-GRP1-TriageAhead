{"t": "20:36:54", "kind": "extract", "writes": [["complaint.fever", false]]}
{"t": "20:36:57", "kind": "question", "slot": "dyn:infection.rash", "text": "I understand. Is he currently showing any new rashes?", "fields": ["infection.rash"], "offered": ["infection.rash", "infection.travel_14d", "infection.contacts", "ams.changed_from_baseline", "complaint.pain_rating", "M.anticoagulant"]}
