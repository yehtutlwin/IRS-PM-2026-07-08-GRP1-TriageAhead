{"t": "20:36:43", "kind": "question", "slot": "dyn:E.mechanism+patient.sex", "text": "I'm sorry to hear about his fall. Is he a man or a woman?", "fields": ["E.mechanism", "patient.sex"], "offered": ["E.mechanism", "patient.sex", "complaint.fever", "infection.rash", "infection.travel_14d", "infection.contacts"]}
