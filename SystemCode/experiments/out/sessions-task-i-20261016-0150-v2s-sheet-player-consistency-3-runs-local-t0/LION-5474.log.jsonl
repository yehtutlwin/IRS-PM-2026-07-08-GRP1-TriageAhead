{"t": "01:18:00", "kind": "question", "slot": "dyn:complaint.onset+patient.age", "text": "I understand he can't stand after the fall. When did this happen, and how old is he?", "fields": ["complaint.onset", "patient.age"], "offered": ["complaint.onset", "patient.age", "patient.sex", "complaint.fever", "infection.rash", "infection.travel_14d"]}
