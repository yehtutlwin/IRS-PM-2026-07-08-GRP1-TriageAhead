{"t": "01:18:07", "kind": "question", "slot": "dyn:patient.sex", "text": "I'm sorry to hear about his fall. Is he a man or a woman?", "fields": ["patient.sex"], "offered": ["patient.sex", "complaint.fever", "infection.rash", "infection.travel_14d", "infection.contacts", "ams.changed_from_baseline"]}
