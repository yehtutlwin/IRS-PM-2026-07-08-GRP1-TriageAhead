{"t": "01:18:14", "kind": "question", "slot": "dyn:complaint.fever+infection.rash", "text": "Does he have a fever or any new rashes on his body?", "fields": ["complaint.fever", "infection.rash"], "offered": ["complaint.fever", "infection.rash", "infection.travel_14d", "infection.contacts", "ams.changed_from_baseline", "complaint.pain_rating"]}
