# Copy to .env and fill in — .env is gitignored, never commit real keys.

# Which LLM answers: "gemini" (cloud, default) or "ollama" (local server, no quota).
# For ollama: install from https://ollama.com/download, then once:
#   ollama pull gemma4:12b
# LLM_BACKEND=ollama
# OLLAMA_MODEL=gemma4:12b
# OLLAMA_HOST=http://localhost:11434

# Free Gemini API key(s) from https://aistudio.google.com/apikey
# Comma-separate several keys (separate Google Cloud projects = separate daily quotas):
GEMINI_API_KEY=your_key_here

# Where interview sessions (state, logs, transcripts, reports) are written.
# Absolute, or relative to the repo root. Default: prototype/out/sessions-local (ignored by git).
# SESSIONS_DIR=prototype/out/sessions-local

# Optional overrides (defaults live in prototype/llm.py):
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash
# GEMINI_PACE=5

